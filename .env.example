# Bitbucket API credentials
# Copy this file to .env, fill in your values, and chmod 600.
#
# Create an API token: https://bitbucket.org/account/settings/api-tokens/
# Required scopes:
#   - read:repository:bitbucket
#   - read:pullrequest:bitbucket
#   - write:pullrequest:bitbucket
#   - read:pipeline:bitbucket    (optional; for 'pr checks' Pipelines output and 'pr logs' / 'pipeline log')

BB_BASH_EMAIL="your-email@example.com"
BB_BASH_TOKEN="your-api-token-here"

# Optional overrides:
# Workspace/repo are auto-detected from the current directory's git remote
# (see docs/design.md). Uncomment to force a specific value when running
# outside a git repo:
# BB_BASH_WORKSPACE="your-workspace"
# BB_BASH_REPO="your-repo"
#
# Override which git remote to use for auto-detect (default: scan for any
# remote pointing to bitbucket.org):
# BB_BASH_REMOTE="bb"
#
# How many recent pipelines 'pr checks' / 'pr logs' / 'pipeline log' scan when
# looking for this branch's build (default 20, max 100 — Bitbucket's pagelen
# cap). Worth persisting here on a busy repo, where a PR's pipeline can fall
# outside the default window:
# BB_BASH_PIPELINE_SCAN="100"
