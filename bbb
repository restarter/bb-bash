#!/usr/bin/env bash
#
# bb-bash - Bitbucket Cloud API wrapper
#
# Reads credentials from .env file next to the *real* script (symlinks are
# resolved through resolve_script_dir, so a PATH symlink at /usr/local/bin or
# ~/.local/bin still locates .env in the data directory). Copy .env.example
# to .env and fill in your values, or install via the curl-pipe-bash flow
# documented in README.md / scripts/install.sh.
#
# Usage (see usage() for the live list; this header summarizes):
#   bbb pr list [--state=<s>] [--author=<u>]   - List PRs (default: open)
#   bbb pr create <target> <title> [desc]      - Create PR from current branch
#   bbb pr update <id> [--title=...] [--description=...] [--reviewers=u1,u2] [--destination=<branch>]
#                                                 - Update PR metadata; --destination retargets the PR
#   bbb pr show <id>                           - PR details + changed files
#   bbb pr open <id>                           - Open PR in default browser
#   bbb pr diff <id>                           - Full diff
#   bbb pr checks <id>                         - CI statuses + Bitbucket Pipelines
#   bbb pr logs <id> [--step=N]                - Pipeline step log for a PR
#   bbb pr comments <id>                       - List comments
#   bbb pr comment <id> <text>                 - Add general comment
#   bbb pr inline [--old] <id> <path> <line> <text>
#                                                 - Inline comment (default new code; --old for deleted)
#   bbb pr approve <id> [id ...]               - Approve PR(s), batch-capable
#   bbb pr request-changes <id> [id ...]       - Mark Changes Requested, PR stays open, batch-capable
#   bbb pr unrequest-changes <id> [id ...]     - Withdraw Changes Requested, batch-capable
#   bbb pr decline <id> [id ...]               - Decline (close without merge), batch-capable
#   bbb pr merge <id> [--squash|--commit|--ff] [--delete-branch] [--message=...]
#                                                 - Merge PR (default strategy: merge_commit)
#   bbb pr reply <pr_id> <comment_id> <text>   - Reply to a comment
#   bbb pr edit-comment <pr_id> <comment_id> <text>
#                                                 - Edit a comment
#   bbb pr delete-comment <pr_id> <comment_id> - Delete a comment
#   bbb pipeline log <build#> [--step=N]       - Pipeline step log by build number
#   bbb raw [--text] <endpoint>                - Raw API call (GET; --text skips jq)
#   bbb raw-post <endpoint> <json>             - Raw API call (POST)
#   bbb install-agent [--rule] [--skill] [--claude] [--agents]
#                                                 - Drop AI-agent integration artifacts into $PWD

set -euo pipefail

# --- Config ---
# Email and token are required for all invocations; WORKSPACE/REPO are
# resolved by the top-level block at the bottom of this file, via
# resolve_workspace_repo(). When sourced for testing (BASH_SOURCE guard),
# the top-level block is skipped — tests set globals manually.

# Resolve workspace/repo from git remote (or env override).
# Precedence:
#   1. $BB_BASH_REMOTE → use that remote's URL
#   2. 'origin' if its URL matches bitbucket.org
#   3. First remote whose URL matches bitbucket.org
#   4. $BB_BASH_WORKSPACE + $BB_BASH_REPO env vars
#   5. Error with help
resolve_workspace_repo() {
    local url remote
    if [[ -n "${BB_BASH_REMOTE:-}" ]]; then
        url=$(git remote get-url -- "$BB_BASH_REMOTE" 2>/dev/null) \
            || die "BB_BASH_REMOTE='$BB_BASH_REMOTE' is not a known git remote in this directory"
    else
        url=$(git remote get-url origin 2>/dev/null || true)
        if ! [[ "$url" =~ (^|@|/)bitbucket\.org[:/] ]]; then
            url=""
            for remote in $(git remote 2>/dev/null); do
                local candidate
                candidate=$(git remote get-url -- "$remote" 2>/dev/null || true)
                if [[ "$candidate" =~ (^|@|/)bitbucket\.org[:/] ]]; then
                    url="$candidate"
                    break
                fi
            done
        fi
    fi

    if [[ -n "$url" ]]; then
        # Normalize: strip trailing slash, then .git, then trailing slash again
        local stripped="${url%/}"
        stripped="${stripped%.git}"
        stripped="${stripped%/}"
        # Drop everything up to and including bitbucket.org[:/]
        stripped="${stripped#*bitbucket.org[:/]}"
        WORKSPACE="${stripped%%/*}"
        local rest="${stripped#*/}"
        REPO="${rest%%/*}"  # drop any trailing path segments

        # Validate against Bitbucket slug grammar
        if ! [[ "$WORKSPACE" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$ ]]; then
            die "Invalid workspace slug parsed from remote URL: '$WORKSPACE' (URL: $url)"
        fi
        if ! [[ "$REPO" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$ ]]; then
            die "Invalid repo slug parsed from remote URL: '$REPO' (URL: $url)"
        fi
    else
        WORKSPACE="${BB_BASH_WORKSPACE:-}"
        REPO="${BB_BASH_REPO:-}"
        if [[ -z "$WORKSPACE" || -z "$REPO" ]]; then
            die "Cannot resolve Bitbucket workspace/repo.
Tried in order:
  1. \$BB_BASH_REMOTE env var
  2. 'origin' remote (must point to bitbucket.org)
  3. Any remote pointing to bitbucket.org
  4. \$BB_BASH_WORKSPACE and \$BB_BASH_REPO env vars

Set env vars or run from a directory inside a bitbucket.org repo."
        fi
    fi
}

# --- Helpers ---
die() { echo "Error: $*" >&2; exit 1; }

# resolve_script_dir: print the directory containing the *real* bbb script,
# resolving any chain of symlinks portably (no `readlink -f` / `realpath` —
# macOS bash 3.2 only has BSD readlink). Used at startup to anchor .env
# discovery to the real script location, not the directory of the symlink it
# was invoked through. Defined here in Helpers (not inside the BASH_SOURCE
# guard) so tests can source bbb and exercise this function directly
# without firing main().
#
# Bails via `die` on cycle (40-hop cap) or broken-symlink (resolved target's
# parent directory doesn't exist). Uses logical `pwd`, not `pwd -P`, so
# symlinks in the parent directory chain are preserved — only the script
# file's own symlink hops are resolved.
resolve_script_dir() {
    # `${1-default}` (no colon) substitutes only when $1 is UNSET; an explicit
    # empty string ("") falls through to the guard below so caller bugs like
    # `resolve_script_dir "$(cmd_that_returned_empty)"` fail loudly.
    local target=${1-${BASH_SOURCE[0]}}
    [[ -n "$target" ]] || die "resolve_script_dir: empty target"
    local link hops=0
    while [[ -L "$target" ]]; do
        hops=$((hops + 1))
        if [ "$hops" -gt 40 ]; then
            die "too many symlink hops resolving $target (cycle?)"
        fi
        link=$(readlink -- "$target")
        case "$link" in
            /*) target="$link" ;;
            *)  target="$(dirname -- "$target")/$link" ;;
        esac
    done
    local dir
    dir=$(dirname -- "$target")
    [[ -d "$dir" ]] || die "cannot resolve bbb source: $target (broken symlink?)"
    cd -- "$dir" && pwd
}

require_args() {
    local need="$1" have="$2" msg="$3"
    [[ "$have" -ge "$need" ]] || die "$msg"
}

# require_numeric <field-name> <value>
# Validates that a CLI-supplied identifier (PR id, comment id) is a
# non-negative integer before it gets interpolated into a URL path.
# Not a security boundary (the user authenticates as themselves), but
# prevents path-traversal-like surprises and gives clear error messages.
require_numeric() {
    local name="$1" val="$2"
    [[ "$val" =~ ^[0-9]+$ ]] || die "$name must be numeric, got: $val"
}

# urlencode <string> — percent-encode a value for use in a URL path or query
# segment. Pipeline UUIDs arrive brace-wrapped ({...}) and MUST be encoded
# (%7B...%7D) before being spliced into a path.
urlencode() {
    jq -rn --arg s "$1" '$s | @uri'
}

# Shared jq prelude: normalizes Bitbucket's several state vocabularies down to
# pass / running / fail / stopped. Prepend to any filter that renders a state,
# so PR statuses, pipelines and pipeline steps cannot drift apart.
#
# Use it as: jq -r "$JQ_NORM"'<filter>'  — the prelude is DOUBLE-quoted so it
# expands, the filter stays SINGLE-quoted so jq's own $vars and \(...) survive
# bash. Collapsing the two into one double-quoted string breaks every filter
# that uses --arg. Keep them adjacent: a stray space makes jq read the filter
# as a filename.
#
# norm() is total on purpose: a step object can arrive with no .state at all,
# and `null | ascii_upcase` is a hard jq error that would abort the caller.
#
# pstate is the pipeline/step accessor — the `.state.result.name // .state.name`
# shape appeared in three renderers before it was folded in here.
# SC2016: $st is a jq variable, not a shell one — single quotes are required
# here so bash leaves it for jq.
# shellcheck disable=SC2016
JQ_NORM='def norm(s):
  (s // "unknown") as $st
  | {SUCCESSFUL: "pass", SUCCESS: "pass", PASSED: "pass",
     INPROGRESS: "running", IN_PROGRESS: "running", PENDING: "running", RUNNING: "running",
     FAILED: "fail", FAILURE: "fail", ERROR: "fail",
     STOPPED: "stopped", HALTED: "stopped", CANCELLED: "stopped",
     PAUSED: "stopped"}
    [$st | ascii_upcase] // ($st | ascii_downcase);
def pstate: norm(.state.result.name // .state.name);'

# require_pipeline_scan — validate BB_BASH_PIPELINE_SCAN and publish PIPELINE_SCAN.
#
# MUST be called as a plain statement, never inside $( ) or an `if` condition:
# die() from inside a command substitution kills only the subshell, so a check
# that has to be fatal must run in the caller's own shell first. Bitbucket caps
# pagelen at 100, so a larger window would be truncated server-side — reject it
# rather than pretend it works.
require_pipeline_scan() {
    PIPELINE_SCAN="${BB_BASH_PIPELINE_SCAN:-20}"
    require_numeric "BB_BASH_PIPELINE_SCAN" "$PIPELINE_SCAN"
    # Strip leading zeros before the numeric comparison: [[ n -ge 1 ]] treats a
    # 0-prefixed operand as octal (0144 -> 100, so it would slip past the cap;
    # 08/09 raise a bash 'value too great for base' error instead of our die).
    local n=$((10#$PIPELINE_SCAN))
    [[ "$n" -ge 1 && "$n" -le 100 ]] \
        || die "BB_BASH_PIPELINE_SCAN must be 1-100 (Bitbucket's pagelen cap), got: $PIPELINE_SCAN"
    PIPELINE_SCAN="$n"
}

# api_get [--soft] <endpoint>
# Default: dies on HTTP >=400.
# --soft: prints body to stdout, returns 1 on HTTP >=400.
api_get() {
    local soft=0
    if [[ "${1:-}" == "--soft" ]]; then
        soft=1
        shift
    fi
    local endpoint="$1"
    local url="${BASE_URL}${endpoint}"
    local response http_code body
    # Check curl's own exit status. Without it a DNS/TLS/connection failure
    # (exit 6/7/35) yields an empty body AND an empty http_code, and
    # [[ "" -ge 400 ]] is FALSE — so the transport error would sail through
    # this function as a successful empty response.
    #
    # -L is required: the pipeline step-log endpoint 302s to signed storage.
    # NEVER add --location-trusted — curl deliberately strips the -u
    # credentials when the redirect changes origin, and the signed URL needs
    # no auth. Trusting the redirect would leak the token to the storage host.
    response=$(curl -s -L -w "\n%{http_code}" -u "${AUTH}" "$url") \
        || die "network error contacting Bitbucket (curl failed): $url"
    http_code=$(echo "$response" | tail -n1)
    body=$(echo "$response" | sed '$d')
    if [[ "$http_code" -ge 400 ]]; then
        if [[ $soft -eq 1 ]]; then
            echo "$body"
            return 1
        fi
        local msg
        msg=$(echo "$body" | jq -r '.error.message // .error // empty' 2>/dev/null || echo "$body")
        die "API error (HTTP $http_code): ${msg:-$body}"
    fi
    echo "$body"
}

# api_post [--soft] <endpoint> <data>
# Default: dies on HTTP >=400.
# --soft: prints body to stdout, returns 1 on HTTP >=400.
# Use --soft for batch commands so one failure doesn't abort the loop.
# Use --soft for optional endpoints (e.g. pipelines) that may 403 on token scope.
api_post() {
    local soft=0
    if [[ "${1:-}" == "--soft" ]]; then
        soft=1
        shift
    fi
    local endpoint="$1"
    local data="$2"
    local url="${BASE_URL}${endpoint}"
    local response http_code body
    # See api_get: curl's exit status must be checked, an empty http_code
    # passes the >=400 gate.
    response=$(curl -s -w "\n%{http_code}" -u "${AUTH}" \
        -X POST \
        -H "Content-Type: application/json" \
        -d "$data" \
        "$url") || die "network error contacting Bitbucket (curl failed): $url"
    http_code=$(echo "$response" | tail -n1)
    body=$(echo "$response" | sed '$d')
    if [[ "$http_code" -ge 400 ]]; then
        if [[ $soft -eq 1 ]]; then
            echo "$body"
            return 1
        fi
        local msg
        msg=$(echo "$body" | jq -r '.error.message // .error // empty' 2>/dev/null || echo "$body")
        die "API error (HTTP $http_code): ${msg:-$body}"
    fi
    echo "$body"
}

api_put() {
    local endpoint="$1"
    local data="$2"
    local url="${BASE_URL}${endpoint}"
    local response http_code body
    response=$(curl -s -w "\n%{http_code}" -u "${AUTH}" \
        -X PUT \
        -H "Content-Type: application/json" \
        -d "$data" \
        "$url") || die "network error contacting Bitbucket (curl failed): $url"
    http_code=$(echo "$response" | tail -n1)
    body=$(echo "$response" | sed '$d')
    if [[ "$http_code" -ge 400 ]]; then
        local msg
        msg=$(echo "$body" | jq -r '.error.message // .error // empty' 2>/dev/null || echo "$body")
        die "API error (HTTP $http_code): ${msg:-$body}"
    fi
    echo "$body"
}

api_delete() {
    local endpoint="$1"
    local url="${BASE_URL}${endpoint}"
    curl -s -o /dev/null -w "%{http_code}" -u "${AUTH}" \
        -X DELETE \
        "$url" || die "network error contacting Bitbucket (curl failed): $url"
}

# batch_action <label> <endpoint-template> <jq-success-msg> "$@"
# Loop over 1+ PR IDs, call api_post --soft on each, print per-PR result.
# Sleep 0.3s (or $BB_BASH_BATCH_DELAY) between calls when total > 1.
#
# Arguments:
#   $1 = label              human verb past tense (e.g. "approved by", "declined")
#   $2 = endpoint-template  with literal {id} placeholder (e.g. "/pullrequests/{id}/approve")
#   $3 = jq-success-msg     jq expression applied to response body for success suffix
#   $@ = PR IDs
batch_action() {
    local label="$1" endpoint_tmpl="$2" jq_msg="$3"
    shift 3
    local id resp total=$# i=0
    for id in "$@"; do
        require_numeric "PR id" "$id"
        i=$((i + 1))
        local endpoint="${endpoint_tmpl//\{id\}/$id}"
        if resp=$(api_post --soft "$endpoint" "{}"); then
            local msg
            # Coerce null/empty to "ok" inside jq so we never print "(null)".
            msg=$(echo "$resp" | jq -r "($jq_msg) // \"ok\" | tostring" 2>/dev/null || echo "ok")
            [[ -z "$msg" || "$msg" == "null" ]] && msg="ok"
            printf 'PR #%-5s %s (%s)\n' "$id" "$label" "$msg"
        else
            # An EMPTY body here is not a per-PR HTTP error. api_post's transport
            # `die` runs inside this $( ), so it kills only the subshell — its
            # exit status never reaches ours. Unguarded, a dead network printed
            # "error:" with no text for every id and the batch still exited 0,
            # a silent failure for anything scripting this. Transport errors are
            # fatal by design (see api_get/api_post), so abort rather than march
            # through the remaining ids against a network that is down.
            if [[ -z "$resp" ]]; then
                die "empty response from Bitbucket at PR #${id} (network failure, or an empty error body) - batch aborted"
            fi
            local err
            err=$(echo "$resp" | jq -r '.error.message // .error // "unknown error"' 2>/dev/null \
                || echo "unparseable response")
            # jq's `//` only falls through on null/false, so an error body
            # carrying an empty message string reaches here blank.
            [[ -z "$err" ]] && err="unknown error"
            printf 'PR #%-5s error: %s\n' "$id" "$err"
        fi
        if [[ $total -gt 1 && $i -lt $total ]]; then
            sleep "${BB_BASH_BATCH_DELAY:-0.3}"
        fi
    done
}

# _install_agent_fetch <src-rel-path> <dest-abs-or-rel-path>
# Download docs/<src> from the bbb repo (ref from BB_BASH_REF, default main)
# and write to <dest>. Honors $INSTALL_AGENT_DRY_RUN and $INSTALL_AGENT_FORCE
# (set by cmd_install_agent before calling).
_install_agent_fetch() {
    local src="$1" dest="$2"
    local ref="${BB_BASH_REF:-main}"
    local url="https://raw.githubusercontent.com/restarter/bb-bash/${ref}/docs/agents/${src}"

    if [[ "${INSTALL_AGENT_DRY_RUN:-false}" == "true" ]]; then
        echo "  [dry-run] fetch: $url"
        echo "  [dry-run]    to: $dest"
        return 0
    fi

    if [[ -e "$dest" && "${INSTALL_AGENT_FORCE:-false}" != "true" ]]; then
        echo "  skip: $dest (exists; use --force to overwrite)"
        return 0
    fi

    mkdir -p -- "$(dirname -- "$dest")"
    if ! curl --proto '=https' --tlsv1.2 -fsSL --max-redirs 5 "$url" -o "$dest"; then
        die "failed to fetch $url"
    fi
    echo "  installed: $dest"
}

# _install_agent_md_section <dest-file>
# Append the bbb agent snippet to <dest-file> (CLAUDE.md or AGENTS.md).
# Modes:
#   - dest missing       -> create with snippet
#   - dest has marker    -> skip (use --force to re-append)
#   - dest exists no mkr -> append with '---' separator
_install_agent_md_section() {
    local dest="$1"
    local ref="${BB_BASH_REF:-main}"
    local url="https://raw.githubusercontent.com/restarter/bb-bash/${ref}/docs/agents/bb-bash-snippet.md"
    local marker='## Bitbucket via bb-bash'

    if [[ "${INSTALL_AGENT_DRY_RUN:-false}" == "true" ]]; then
        echo "  [dry-run] fetch: $url"
        if [[ -f "$dest" ]] && grep -qF "$marker" "$dest"; then
            echo "  [dry-run]   skip: $dest already contains bbb section"
        elif [[ -f "$dest" ]]; then
            echo "  [dry-run] append to: $dest"
        else
            echo "  [dry-run]   create: $dest"
        fi
        return 0
    fi

    if [[ -f "$dest" ]] && grep -qF "$marker" "$dest" && [[ "${INSTALL_AGENT_FORCE:-false}" != "true" ]]; then
        echo "  skip: $dest already has bbb section (use --force to re-append)"
        return 0
    fi

    local tmp
    tmp=$(mktemp)
    if ! curl --proto '=https' --tlsv1.2 -fsSL --max-redirs 5 "$url" -o "$tmp"; then
        rm -f "$tmp"
        die "failed to fetch $url"
    fi

    # Ensure parent dir exists — required for global mode where $HOME/.claude/
    # may not have been created yet. No-op for project-level (parent is cwd).
    mkdir -p -- "$(dirname -- "$dest")"

    if [[ -f "$dest" ]]; then
        # Atomic-ish append: assemble (existing + separator + snippet) in a
        # tmp file on the same FS, then rename onto $dest. A SIGINT or
        # disk-full between the partial writes can't leave $dest with a
        # separator but no snippet — rename either fully succeeds or leaves
        # the original intact.
        local merged
        merged=$(mktemp -- "${dest}.bb-bash-XXXXXX")
        cat -- "$dest" > "$merged"
        printf '\n\n---\n\n' >> "$merged"
        cat -- "$tmp" >> "$merged"
        mv -- "$merged" "$dest"
        echo "  appended to: $dest"
    else
        cp -- "$tmp" "$dest"
        echo "  created: $dest"
    fi
    rm -f -- "$tmp"
}

# _agent_status_line <path>: print "  [present]" or "  [missing]" + path
_agent_status_line() {
    local p="$1"
    if [[ -e "$p" ]]; then
        echo "  [present] $p"
    else
        echo "  [missing] $p"
    fi
}

# _agent_status_line_marked <path> <marker>: like _agent_status_line but
# distinguishes "file exists with bbb section" from "file exists but no
# section yet". Used for CLAUDE.md / AGENTS.md which may pre-exist for
# other reasons.
_agent_status_line_marked() {
    local p="$1" marker="$2"
    if [[ -f "$p" ]]; then
        if grep -qF "$marker" "$p"; then
            echo "  [present] $p (has bbb section)"
        else
            echo "  [no-section] $p (exists, no bbb section)"
        fi
    else
        echo "  [missing] $p"
    fi
}

# --- Commands ---
# pr list [--state=open|merged|declined|superseded|all] [--author=<user>]
# Default --state=open preserves prior behavior.
# Note: --reviewer is not yet supported because Bitbucket BBQL doesn't
# allow filtering on `reviewers.username`. Tracked in bb-api-oja.
cmd_pr_list() {
    local state="OPEN" author=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --state=*)
                local raw="${1#--state=}"
                # POSIX-portable case conversion (avoid bash 4+ ${var,,}/${var^^})
                local raw_lower raw_upper
                raw_lower=$(echo "$raw" | tr '[:upper:]' '[:lower:]')
                raw_upper=$(echo "$raw" | tr '[:lower:]' '[:upper:]')
                case "$raw_lower" in
                    open|merged|declined|superseded)  state="$raw_upper" ;;
                    all)                              state="" ;;
                    *)                                die "Unknown --state value: $raw (open|merged|declined|superseded|all)" ;;
                esac
                ;;
            --author=*)
                author="${1#--author=}"
                ;;
            --reviewer=*)
                die "--reviewer filter is not yet supported (BBQL limitation). Tracked in bb-api-oja."
                ;;
            *)
                die "Unknown flag: $1"
                ;;
        esac
        shift
    done

    local query="pagelen=50"
    [[ -n "$state" ]] && query="${query}&state=${state}"

    # Build BBQL filter; join with " AND " via explicit loop (IFS join uses
    # only first character of IFS, so the IFS=' AND ' trick silently joins
    # on space).
    local filters=()
    if [[ -n "$author" ]]; then
        local quoted
        quoted=$(jq -Rrn --arg v "$author" '"author.username=" + ($v | tojson)')
        filters+=("$quoted")
    fi
    if [[ ${#filters[@]} -gt 0 ]]; then
        local q="${filters[0]}"
        local f
        for f in "${filters[@]:1}"; do
            q="${q} AND ${f}"
        done
        # Full URL-encode via jq @uri (handles &, +, #, %, ?, unicode, etc.
        # — not just space and quote as the previous two-substitution hack did)
        local q_encoded
        q_encoded=$(urlencode "$q")
        query="${query}&q=${q_encoded}"
    fi

    api_get "/pullrequests?${query}" | jq -r '
        .values[] | "PR #\(.id) [\(.state)] \(.title)\n  Author: \(.author.display_name)\n  Branch: \(.source.branch.name) -> \(.destination.branch.name)\n"'
}

cmd_pr_create() {
    local target="$1"
    local title="$2"
    shift 2
    local description="${*:-}"

    [[ -n "$target" ]] || die "Target branch is required"
    [[ -n "$title" ]] || die "Title is required"

    local source
    source=$(git -C "$(pwd)" symbolic-ref --short HEAD 2>/dev/null) \
        || die "Cannot detect current git branch (run from inside the repo)"

    if [[ "$source" == "$target" ]]; then
        die "Source and target are the same branch: $source"
    fi

    local payload
    payload=$(jq -nc \
        --arg title "$title" \
        --arg desc "$description" \
        --arg src "$source" \
        --arg dst "$target" \
        '{title: $title, description: $desc, source: {branch: {name: $src}}, destination: {branch: {name: $dst}}}')

    api_post "/pullrequests" "$payload" \
        | jq -r '"PR #\(.id) created: \(.links.html.href)"'
}

# pr update <id> [--title=...] [--description=...] [--reviewers=user1,user2] [--destination=<branch>]
# Reviewers list is FULL replacement (Bitbucket API has no PATCH semantics).
# Reviewers passed as Bitbucket usernames; the API has been deprecating
# username as a stable identifier — tracked in bb-api-oja for UUID migration.
#
# --destination retargets the PR. Stacked PRs need this: once the base PR
# merges, its child still points at a branch that no longer receives commits.
cmd_pr_update() {
    require_args 1 $# "Usage: bbb pr update <id> [--title=<t>] [--description=<d>] [--reviewers=u1,u2] [--destination=<branch>]"
    local pr_id="$1"
    require_numeric "PR id" "$pr_id"
    shift
    local title="" desc="" reviewers="" dest=""
    local title_set=0 desc_set=0 reviewers_set=0 dest_set=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --title=*)        title="${1#--title=}"; title_set=1 ;;
            --description=*)  desc="${1#--description=}"; desc_set=1 ;;
            --reviewers=*)    reviewers="${1#--reviewers=}"; reviewers_set=1 ;;
            --destination=*)  dest="${1#--destination=}"; dest_set=1 ;;
            *)                die "Unknown flag: $1" ;;
        esac
        shift
    done
    [[ $title_set -eq 1 || $desc_set -eq 1 || $reviewers_set -eq 1 || $dest_set -eq 1 ]] \
        || die "Nothing to update (pass --title, --description, --reviewers, or --destination)"
    # An empty --destination= is a caller mistake, not a "clear the field" request:
    # a PR always has a destination, so there is nothing to clear it to.
    [[ $dest_set -eq 0 || -n "$dest" ]] || die "--destination requires a branch name"

    # Send the field if the flag was passed, even when the value is empty
    # (clearing description, for example). Previously empty values were
    # silently dropped, producing a no-op PUT that pretended to succeed.
    local payload="{}"
    [[ $title_set -eq 1 ]]    && payload=$(echo "$payload" | jq -c --arg t "$title" '. + {title: $t}')
    [[ $desc_set -eq 1 ]]     && payload=$(echo "$payload" | jq -c --arg d "$desc" '. + {description: $d}')
    if [[ $reviewers_set -eq 1 ]]; then
        local arr
        arr=$(echo "$reviewers" | jq -Rc 'split(",") | map(select(length > 0)) | map({username: .})')
        payload=$(echo "$payload" | jq -c --argjson r "$arr" '. + {reviewers: $r}')
    fi

    # Bitbucket rejects a destination-only PUT: the body must carry a title. So a
    # retarget reads the current title back and resends it.
    #
    # ONLY the title. PUT-ing the whole GET body would echo server-owned fields
    # (state, links, author, merge_commit) back at the API and invite a 400. The
    # fetch is conditional on purpose — plain --title/--description updates keep
    # working through the partial PUT above, with no extra round trip.
    if [[ $dest_set -eq 1 ]]; then
        if [[ $title_set -eq 0 ]]; then
            local current_title
            # `// empty` is load-bearing: a bare `jq -r .title` on a missing or
            # null field prints the literal string "null", which would then be
            # written BACK as the title — the exact damage this read-back exists
            # to prevent. Empty output plus the guard fails loudly instead.
            current_title=$(api_get "/pullrequests/${pr_id}" | jq -r '.title // empty')
            [[ -n "$current_title" ]] || die "could not read the current title of PR #${pr_id}"
            payload=$(echo "$payload" | jq -c --arg t "$current_title" '. + {title: $t}')
        fi
        payload=$(echo "$payload" | jq -c --arg b "$dest" '. + {destination: {branch: {name: $b}}}')
    fi

    api_put "/pullrequests/${pr_id}" "$payload" \
        | jq -r '"PR #\(.id) updated: \(.links.html.href // "ok")"'
}

cmd_pr_show() {
    local pr_id="$1"
    require_numeric "PR id" "$pr_id"
    local pr
    pr=$(api_get "/pullrequests/${pr_id}")

    echo "$pr" | jq -r '"PR #\(.id): \(.title)
State:       \(.state)
Author:      \(.author.display_name)
Branch:      \(.source.branch.name) -> \(.destination.branch.name)
Created:     \(.created_on // "n/a")
Updated:     \(.updated_on // "n/a")
Description: \(.description // "(none)")
Link:        \(.links.html.href // "n/a")"'

    echo ""
    echo "--- Changed files ---"
    api_get "/pullrequests/${pr_id}/diffstat" | jq -r '
        .values[] | "\(.status | if . == "added" then "+" elif . == "removed" then "-" else "M" end) \(.new.path // .old.path)  (+\(.lines_added) -\(.lines_removed))"'
}

# pr open <id> — open PR in default browser (macOS 'open', Linux 'xdg-open')
cmd_pr_open() {
    require_args 1 $# "Usage: bbb pr open <id>"
    local pr_id="$1"
    require_numeric "PR id" "$pr_id"
    local url
    url=$(api_get "/pullrequests/${pr_id}" | jq -r '.links.html.href // empty')
    [[ -n "$url" ]] || die "Could not resolve PR #${pr_id} URL"

    local opener=""
    case "$(uname -s)" in
        Darwin)  opener="open" ;;
        Linux)   opener="xdg-open" ;;
        *)       echo "$url"; return 0 ;;
    esac

    if command -v "$opener" >/dev/null 2>&1; then
        "$opener" "$url"
    else
        echo "$url"
    fi
}

cmd_pr_diff() {
    local pr_id="$1"
    require_numeric "PR id" "$pr_id"
    curl -s -L -u "${AUTH}" \
        -H "Accept: text/plain" \
        "${BASE_URL}/pullrequests/${pr_id}/diff"
}

# pipelines_for_pr <pr_id> <source_branch>
# PR-triggered pipelines carry target.source with target.ref_name = null; only
# branch-triggered ones set target.ref_name. So NO ref_name filter — server-side
# or BBQL — can ever match a PR pipeline. Fetch the recent window and match both
# target shapes client-side.
#
# (The earlier code passed a bare `target.ref_name=<branch>` query param and got
# count=0 back. Whether the endpoint honoured that param or discarded it is not
# established — and does not matter: the null ref_name alone makes ref_name
# filtering unusable here. Don't restate the stronger claim without evidence.)
#
# Requires PIPELINE_SCAN — call require_pipeline_scan in the CALLER first. This
# function is only ever invoked via command substitution, so a die() in here
# would kill just the subshell and the caller would misreport the cause.
#
# Prints ONE JSON object: { scanned, limit, matches }, matches newest first —
# sorted client-side rather than trusting the endpoint's sort= param, since the
# whole premise here is that this endpoint's query handling is not to be assumed.
# Returns 1 when the pipelines endpoint is unavailable (e.g. missing scope).
#
# The scan counters ride inside the JSON deliberately: callers use command
# substitution (a subshell), so shell globals set here would not reach them and
# "scan window too small" — which looks exactly like the bug this fixes — could
# never be reported.
pipelines_for_pr() {
    local branch="$2" body
    local scan="${PIPELINE_SCAN:?internal error: require_pipeline_scan was not called}"
    # Normalize the PR id to a number for the --argjson comparison below.
    # require_numeric accepts "007"; 10# forces base-10 so [[ ]] and the shell
    # don't read a 0-prefixed value as octal. (jq itself does accept
    # `--argjson pr 007`, so this is about the shell, not jq.)
    local pr_id=$((10#$1))
    if ! body=$(api_get --soft "/pipelines/?sort=-created_on&pagelen=${scan}"); then
        return 1
    fi
    echo "$body" | jq --arg branch "$branch" --argjson pr "$pr_id" --argjson scan "$scan" '
        { scanned: (.values | length),
          limit:   $scan,
          matches: [ .values[]?
            | select(
                # A tag can share a name with a branch — ref_type disambiguates.
                # NOTE: the "TAG" casing here is still unverified (the live check
                # had only PR pipelines, whose targets carry null ref_type);
                # the // "BRANCH" fallback keeps it safe until a branch/tag
                # sample confirms the enum.
                (.target.ref_name == $branch and (.target.ref_type // "BRANCH") != "TAG")
                or .target.source == $branch
                # PR id: field is .target.pullrequest.id (NO underscore) —
                # verified live against pipeline_pullrequest_target. Matches a PR
                # even after its source branch is renamed, and separates a live
                # PR from a declined one on the same branch that .source cannot.
                or (.target.pullrequest.id // null) == $pr
              ) ]
            | sort_by(.created_on) | reverse }'
}

# pr checks <id> — show PR statuses + Bitbucket Pipelines for source branch
cmd_pr_checks() {
    require_args 1 $# "Usage: bbb pr checks <id>"
    local pr_id="$1"
    require_numeric "PR id" "$pr_id"
    # Must run here, in this shell — see require_pipeline_scan.
    require_pipeline_scan

    # Fetch PR to get source branch name
    local pr branch
    pr=$(api_get "/pullrequests/${pr_id}")
    branch=$(echo "$pr" | jq -r '.source.branch.name')

    # 1) PR-level statuses (external CI: GH Actions, Jenkins, etc.)
    echo "--- PR statuses ---"
    local statuses
    statuses=$(api_get "/pullrequests/${pr_id}/statuses?pagelen=50")
    local status_count
    status_count=$(echo "$statuses" | jq -r '.values | length')
    if [[ "$status_count" -eq 0 ]]; then
        echo "  (no external statuses)"
    else
        echo "$statuses" | jq -r "$JQ_NORM"'
            .values[] | "  [\(norm(.state))] \(.name // .key) — \(.url // "no url")"'
    fi

    # 2) Bitbucket Pipelines matching the PR's source branch.
    # Filtering happens client-side — see pipelines_for_pr for why.
    echo ""
    echo "--- Bitbucket Pipelines (branch: $branch) ---"
    local pipes
    if pipes=$(pipelines_for_pr "$pr_id" "$branch"); then
        local pipe_count scan_hint
        pipe_count=$(echo "$pipes" | jq -r '.matches | length')
        if [[ "$pipe_count" -eq 0 ]]; then
            echo "  (no pipelines for this branch)"
            # A full scan window with zero matches is indistinguishable from a
            # genuine absence unless we say so.
            scan_hint=$(echo "$pipes" | jq -r '
                if .scanned > 0 and .scanned >= .limit
                then "  (scanned the \(.limit) most recent pipelines — raise BB_BASH_PIPELINE_SCAN if this repo is busy)"
                else empty end')
            if [[ -n "$scan_hint" ]]; then
                echo "$scan_hint"
            fi
        else
            echo "$pipes" | jq -r "$JQ_NORM"'
                .matches[]
                | "  #\(.build_number) [\(pstate)] \(.created_on[:16]) — \(.target.commit.hash[:7]) (\(.target.selector.type // "?")) by \(.creator.display_name // "?")"'
        fi
    else
        # Don't assert a cause we haven't established: this also fires on a 5xx,
        # a malformed body, or anything else that makes the fetch fail.
        echo "  (pipelines unavailable — see any error above; the token may lack read:pipeline scope)"
    fi
}

# pipeline_step_log <pipeline_uuid> <label> [step_number]
# Print one step's log. Default step: the first failed one, else the last.
# The log endpoint returns plain text (302 -> signed storage), so its body must
# NOT go through jq — that is what makes `bbb raw .../log` come back empty.
#
# `label` is a presentation string threaded into a fetch helper because bash 3.2
# can't return a struct. It's the seam where a future --json/--quiet will hurt.
pipeline_step_log() {
    local uuid="$1" label="$2" step_n="${3:-}"
    local uuid_enc steps step_json step_uuid step_name step_state
    uuid_enc=$(urlencode "$uuid")
    # pagelen: the steps endpoint defaults to 10, which would silently make the
    # "last step" the tenth on a longer pipeline.
    steps=$(api_get "/pipelines/${uuid_enc}/steps/?pagelen=100")

    if [[ -n "$step_n" ]]; then
        require_numeric "--step" "$step_n"
        # 10#: strip leading zeros so [[ -ge ]] and --argjson don't read 08/09
        # as octal (a bash error) or accept a 0-padded index. require_numeric
        # accepts 0, and .values[0 - 1] is .values[-1] — jq's last element — so
        # the >= 1 guard is what stops --step=0 silently picking the wrong step.
        step_n=$((10#$step_n))
        [[ "$step_n" -ge 1 ]] || die "--step must be 1 or greater, got: $step_n"
        step_json=$(echo "$steps" | jq --argjson n "$step_n" '.values[$n - 1] // empty')
        [[ -n "$step_json" ]] || die "Step ${step_n} not found in ${label}"
    else
        # Select via norm(), not a literal "FAILED": Bitbucket also emits ERROR
        # (and FAILURE) for a failed step, and pr checks renders all three as
        # [fail]. Matching only "FAILED" skipped an ERROR step and handed back a
        # passing step's log — the exact drift JQ_NORM exists to prevent.
        step_json=$(echo "$steps" | jq "$JQ_NORM"'
            [ .values[]? | select(pstate == "fail") ][0]
            // (.values // [])[-1]
            // empty')
        [[ -n "$step_json" ]] || die "${label} has no steps"
    fi

    step_uuid=$(echo "$step_json" | jq -r '.uuid // empty')
    [[ -n "$step_uuid" && "$step_uuid" != "null" ]] \
        || die "${label}: step has no uuid — cannot fetch its log"
    step_name=$(echo "$step_json" | jq -r '.name // "(unnamed)"')
    step_state=$(echo "$step_json" | jq -r "$JQ_NORM"' pstate')

    # A step that hasn't finished has no log yet; the endpoint 404s. Say so
    # instead of printing a header and then a raw API error under it.
    if [[ "$step_state" == "running" ]]; then
        die "${label} step \"${step_name}\" is still running — no log yet"
    fi

    # Fetch the log BEFORE printing the header — api_get dies on any error, and
    # a header echoed first would be left dangling above a bare API error (or,
    # for an empty log, above nothing).
    local log
    log=$(api_get "/pipelines/${uuid_enc}/steps/$(urlencode "$step_uuid")/log")
    echo "--- ${label} step \"${step_name}\" [${step_state}] ---"
    printf '%s\n' "$log"
}

# parse_step_flag [args...] — parse a trailing [--step=N] and publish STEP_N.
# Plain statement only, never in a subshell: it dies on a bad flag, and a
# subshell die would be swallowed (see require_pipeline_scan).
parse_step_flag() {
    STEP_N=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --step=)  die "--step= requires a value, e.g. --step=2" ;;
            --step=*) STEP_N="${1#--step=}" ;;
            *)        die "Unknown flag: $1" ;;
        esac
        shift
    done
}

# pipeline log <build#> [--step=N] — print a pipeline step's log.
cmd_pipeline_log() {
    require_args 1 $# "Usage: bbb pipeline log <build#> [--step=N]"
    local build="$1"
    shift
    require_numeric "build number" "$build"

    require_pipeline_scan
    parse_step_flag "$@"

    # /pipelines/{pipeline_uuid} is what the API documents; build numbers work
    # in practice but are not guaranteed, so fall back to scanning the list.
    # Either way VERIFY the build number came back as asked — this endpoint's
    # handling of input it doesn't understand is exactly what the pr checks bug
    # was about, so its answer is checked rather than trusted.
    local uuid="" body
    if body=$(api_get --soft "/pipelines/${build}"); then
        # 2>/dev/null: on a 200 with a non-JSON body, let our die carry the
        # message rather than leaking jq's raw parse error above it.
        uuid=$(echo "$body" | jq -r --argjson b "$build" \
            'select(.build_number == $b) | .uuid // empty' 2>/dev/null) \
            || die "unexpected (non-JSON) response from /pipelines/${build}"
    fi
    if [[ -z "$uuid" ]]; then
        # --soft so we can surface the API's own message rather than a bare
        # exit. Don't assert a cause we haven't established: a 403 does mean a
        # missing scope, but a 500/429/malformed body must not be reported as
        # one — the same hedge the pr checks / pr logs sites use.
        if ! body=$(api_get --soft "/pipelines/?sort=-created_on&pagelen=${PIPELINE_SCAN}"); then
            local msg
            msg=$(echo "$body" | jq -r '.error.message // empty' 2>/dev/null)
            die "Pipelines unavailable: ${msg:-the token may lack read:pipeline scope}"
        fi
        # 2>/dev/null: a non-JSON 200 leaves uuid empty and falls through to the
        # "not found" die below, without a raw jq parse error on the way.
        uuid=$(echo "$body" | jq -r --argjson b "$build" '
            [ .values[]? | select(.build_number == $b) ][0].uuid // empty' 2>/dev/null)
    fi
    [[ -n "$uuid" ]] || die "Pipeline #${build} not found (scanned the ${PIPELINE_SCAN} most recent — raise BB_BASH_PIPELINE_SCAN, max 100)"

    pipeline_step_log "$uuid" "pipeline #${build}" "$STEP_N"
}

# pr logs <id> [--step=N] — log of the newest pipeline for the PR's source branch.
cmd_pr_logs() {
    require_args 1 $# "Usage: bbb pr logs <id> [--step=N]"
    local pr_id="$1"
    shift
    require_numeric "PR id" "$pr_id"

    require_pipeline_scan
    parse_step_flag "$@"

    local pr branch pipes uuid build scan_hint
    pr=$(api_get "/pullrequests/${pr_id}")
    branch=$(echo "$pr" | jq -r '.source.branch.name // "(unknown)"')
    if ! pipes=$(pipelines_for_pr "$pr_id" "$branch"); then
        die "Pipelines unavailable — see any error above; the token may lack read:pipeline scope"
    fi
    uuid=$(echo "$pipes" | jq -r '.matches[0].uuid // empty')
    build=$(echo "$pipes" | jq -r '.matches[0].build_number // "?"')
    if [[ -z "$uuid" ]]; then
        # Same scan-window caveat pr checks reports — without it this reads as
        # "the PR has no pipelines" when the window was simply too small.
        scan_hint=$(echo "$pipes" | jq -r '
            if .scanned > 0 and .scanned >= .limit
            then " (scanned the \(.limit) most recent pipelines — raise BB_BASH_PIPELINE_SCAN, max 100)"
            else "" end')
        die "No pipelines found for PR ${pr_id} (branch: ${branch})${scan_hint}"
    fi

    pipeline_step_log "$uuid" "PR ${pr_id} pipeline #${build}" "$STEP_N"
}

cmd_pr_comments() {
    local pr_id="$1"
    require_numeric "PR id" "$pr_id"
    api_get "/pullrequests/${pr_id}/comments?pagelen=100" | jq -r '
        .values[]
        | select(.deleted != true)
        | "[#\(.id)] [\(.created_on[:16])] \(.user.display_name)" +
          (if .inline then " @ \(.inline.path):\(.inline.to // .inline.from)" else "" end) +
          (if .parent then " (reply to #\(.parent.id))" else "" end) +
          ":\n\(.content.raw)\n---"'
}

cmd_pr_comment() {
    local pr_id="$1"
    require_numeric "PR id" "$pr_id"
    shift
    local text="$*"
    [[ -n "$text" ]] || die "Comment text is required"
    local payload
    payload=$(jq -nc --arg text "$text" '{content: {raw: $text}}')
    api_post "/pullrequests/${pr_id}/comments" "$payload" \
        | jq -r '"Comment posted: \(.links.html.href // "ok")"'
}

cmd_pr_inline() {
    local side="to"  # default: comment on new code
    if [[ "${1:-}" == "--old" ]]; then
        side="from"
        shift
    fi
    require_args 4 $# "Usage: bbb pr inline [--old] <id> <path> <line> <text>"
    local pr_id="$1"
    require_numeric "PR id" "$pr_id"
    local path="$2"
    local line="$3"
    [[ "$line" =~ ^[0-9]+$ ]] || die "Line must be a number, got: $line"
    shift 3
    local text="$*"
    [[ -n "$text" ]] || die "Comment text is required"
    # $side is "to" or "from" — set internally above, never user input.
    # Interpolated into the jq filter literal because jq has no clean dynamic-key form.
    local payload
    payload=$(jq -nc --arg text "$text" --arg path "$path" --argjson line "$line" \
        "{content: {raw: \$text}, inline: {path: \$path, ${side}: \$line}}")
    api_post "/pullrequests/${pr_id}/comments" "$payload" \
        | jq -r '"Inline comment posted: \(.inline.path):\(.inline.to // .inline.from) - \(.links.html.href // "ok")"'
}

cmd_pr_approve() {
    require_args 1 $# "Usage: bbb pr approve <id> [id ...]"
    batch_action "approved by" "/pullrequests/{id}/approve" '.user.display_name // "ok"' "$@"
}

cmd_pr_decline() {
    require_args 1 $# "Usage: bbb pr decline <id> [id ...]"
    batch_action "declined" "/pullrequests/{id}/decline" '.state // "DECLINED"' "$@"
}

# Non-destructive review outcome: marks the caller's participant state as
# changes_requested while the PR stays OPEN. Not to be confused with
# `pr decline`, which closes the PR without merging.
cmd_pr_request_changes() {
    require_args 1 $# "Usage: bbb pr request-changes <id> [id ...]"
    batch_action "changes requested by" "/pullrequests/{id}/request-changes" \
        '.user.display_name // "ok"' "$@"
}

# Withdraw a changes_requested mark. DELETE has no response body, so this
# cannot go through batch_action (POST-only, prints a jq-parsed body); it
# mirrors batch_action's loop shape instead — per-id, continue on failure,
# same inter-call delay.
cmd_pr_unrequest_changes() {
    require_args 1 $# "Usage: bbb pr unrequest-changes <id> [id ...]"
    local id status total=$# i=0
    for id in "$@"; do
        require_numeric "PR id" "$id"
        i=$((i + 1))
        status=$(api_delete "/pullrequests/${id}/request-changes")
        if [[ "$status" == "204" || "$status" == "200" ]]; then
            printf 'PR #%-5s changes-request withdrawn\n' "$id"
        elif [[ "$status" == "404" ]]; then
            # Verified live: withdrawing when the caller has no changes-request
            # on the PR returns 404, same as a PR that doesn't exist. Say both
            # rather than a bare code.
            printf 'PR #%-5s nothing to withdraw (no changes-request by you, or no such PR)\n' "$id"
        else
            printf 'PR #%-5s error: HTTP %s\n' "$id" "$status"
        fi
        # Plain `if`, not `[[ ]] && sleep`: as the loop body's last command the
        # && form returns 1 whenever the condition is false (always so on a
        # single id), which under `set -e` fails the command on success.
        if [[ $total -gt 1 && $i -lt $total ]]; then
            sleep "${BB_BASH_BATCH_DELAY:-0.3}"
        fi
    done
}

# pr merge <id> [--squash|--commit|--ff] [--delete-branch] [--message=<text>]
# Default strategy: merge_commit (Bitbucket's most common UI default).
# Explicit override via flags. No repo-default fetch (the API field
# `.mainbranch.merge_commit_default` does not exist).
cmd_pr_merge() {
    require_args 1 $# "Usage: bbb pr merge <id> [--squash|--commit|--ff] [--delete-branch] [--message=<text>]"
    local pr_id="$1"
    require_numeric "PR id" "$pr_id"
    shift
    local strategy="merge_commit" close_source="false" message=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --squash)         strategy="squash" ;;
            --commit)         strategy="merge_commit" ;;
            --ff)             strategy="fast_forward" ;;
            --delete-branch)  close_source="true" ;;
            --message=*)      message="${1#--message=}" ;;
            *)                die "Unknown flag: $1" ;;
        esac
        shift
    done

    # Bitbucket Cloud uses field name `type` (not `merge_strategy`) for the
    # merge endpoint payload.
    local payload
    payload=$(jq -nc \
        --arg type "$strategy" \
        --argjson close "$close_source" \
        --arg msg "$message" \
        '{type: $type, close_source_branch: $close} + (if $msg == "" then {} else {message: $msg} end)')

    local result hash
    result=$(api_post "/pullrequests/${pr_id}/merge" "$payload")
    hash=$(echo "$result" | jq -r '.merge_commit.hash // ""' | cut -c1-7)
    echo "PR #${pr_id} merged${hash:+ ($hash)} — strategy: $strategy"
}

cmd_pr_reply() {
    local pr_id="$1"
    local comment_id="$2"
    require_numeric "PR id" "$pr_id"
    require_numeric "Comment id" "$comment_id"
    shift 2
    local text="$*"
    [[ -n "$text" ]] || die "Reply text is required"
    local payload
    payload=$(jq -nc --arg text "$text" --argjson cid "$comment_id" \
        '{content: {raw: $text}, parent: {id: $cid}}')
    api_post "/pullrequests/${pr_id}/comments" "$payload" \
        | jq -r '"Reply posted to #\(.parent.id): \(.links.html.href // "ok")"'
}

cmd_pr_edit_comment() {
    local pr_id="$1"
    local comment_id="$2"
    require_numeric "PR id" "$pr_id"
    require_numeric "Comment id" "$comment_id"
    shift 2
    local text="$*"
    [[ -n "$text" ]] || die "Comment text is required"
    local payload
    payload=$(jq -nc --arg text "$text" '{content: {raw: $text}}')
    api_put "/pullrequests/${pr_id}/comments/${comment_id}" "$payload" \
        | jq -r '"Comment #\(.id) updated: \(.links.html.href // "ok")"'
}

cmd_pr_delete_comment() {
    local pr_id="$1"
    local comment_id="$2"
    require_numeric "PR id" "$pr_id"
    require_numeric "Comment id" "$comment_id"
    local status
    status=$(api_delete "/pullrequests/${pr_id}/comments/${comment_id}")
    if [[ "$status" == "204" ]]; then
        echo "Comment ${comment_id} deleted"
    else
        echo "Failed to delete comment ${comment_id} (HTTP ${status})"
    fi
}

cmd_raw() {
    local text=0
    if [[ "${1:-}" == "--text" ]]; then
        text=1
        shift
    fi
    local endpoint="${1:-}"
    [[ -n "$endpoint" ]] || die "Usage: bbb raw [--text] <endpoint>"
    shift
    # Reject trailing args rather than dropping them: `bbb raw /foo --text`
    # would otherwise silently take the jq path and produce the empty stdout
    # that --text exists to fix.
    [[ $# -eq 0 ]] || die "Unexpected argument: $1 (--text must come before the endpoint)"
    if [[ $text -eq 1 ]]; then
        # Plain-text passthrough. Some endpoints (pipeline step logs, diffs)
        # return text; forcing them through jq yields a parse error and, under
        # pipefail, an empty stdout.
        api_get "$endpoint"
    else
        api_get "$endpoint" | jq '.'
    fi
}

cmd_raw_post() {
    local endpoint="$1"
    local data="$2"
    api_post "$endpoint" "$data" | jq '.'
}

# install-agent: drop AI-agent integration artifacts into $PWD.
# Flags combine; no flag = interactive prompt (letter codes).
# Unlike pr/raw commands this one doesn't hit Bitbucket and is allowed to
# run without auth or a Bitbucket-repo CWD — the top-level guard at the
# bottom of this file short-circuits credential resolution for it.
cmd_install_agent() {
    local want_rule=false want_skill=false want_claude=false want_agents=false
    local has_flag=false
    INSTALL_AGENT_DRY_RUN=false
    INSTALL_AGENT_FORCE=false
    INSTALL_AGENT_GLOBAL=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --rule)     want_rule=true; has_flag=true ;;
            --skill)    want_skill=true; has_flag=true ;;
            --claude) want_claude=true; has_flag=true ;;
            --agents)   want_agents=true; has_flag=true ;;
            --global)   INSTALL_AGENT_GLOBAL=true ;;
            --dry-run)  INSTALL_AGENT_DRY_RUN=true ;;
            --force)    INSTALL_AGENT_FORCE=true ;;
            -h|--help)
                cat <<'EOF'
Usage: bbb install-agent [--rule] [--skill] [--claude] [--agents] [--global] [--dry-run] [--force]

Drop AI-agent integration artifacts into the current project (default) or
into user-global Claude Code config (--global).

Artifacts (combine any subset):
  --rule       drop the Claude Code rule
                  project: ./.claude/rules/bb-bash-rule.md
                  global:  ~/.claude/rules/bb-bash-rule.md
  --skill      drop the Claude Code skill
                  project: ./.claude/skills/bb-bash/SKILL.md
                  global:  ~/.claude/skills/bb-bash/SKILL.md
  --claude     append snippet to CLAUDE.md
                  project: ./CLAUDE.md
                  global:  ~/.claude/CLAUDE.md
  --agents     append snippet to AGENTS.md (project only — no standard global path)
                  project: ./AGENTS.md

Modifiers:
  --global     install into user-global Claude Code config ($HOME/.claude/)
               instead of the current project. Requires explicit --rule/--skill/
               --claude (no interactive). --agents is incompatible (no global path).
  --dry-run    Print actions, do not write to disk
  --force      Overwrite existing files / re-append to CLAUDE.md/AGENTS.md

Without flags: interactive prompt (enter letter codes like 'rsca'). Interactive
mode operates on the current project only.

Env:
  BB_BASH_REF   Git ref to fetch artifacts from (default: main).
               Pin to a release tag for reproducibility, e.g. BB_BASH_REF=v0.2.0.

Examples:
  bbb install-agent --rule --skill                  # project-level Claude Code
  bbb install-agent --rule --global                 # user-global rule (every project)
  bbb install-agent --rule --skill --global         # global rule + skill
  bbb install-agent --claude --dry-run              # preview snippet append
  BB_BASH_REF=v0.2.0 bbb install-agent --rule       # pin to a release tag
EOF
                return 0
                ;;
            *) die "Unknown flag: $1 (run 'bbb install-agent --help')" ;;
        esac
        shift
    done

    if [[ "$INSTALL_AGENT_GLOBAL" == "true" ]]; then
        [[ "$has_flag" == "true" ]] || die "--global requires at least one of --rule/--skill/--claude (no interactive mode in global)"
        [[ "$want_agents" != "true" ]] || die "--agents incompatible with --global: AGENTS.md has no standard user-global location. Install per-project (drop --global)."
    fi

    if [[ "$has_flag" != "true" ]]; then
        # Under set -e, read -r -p crashes with no message on EOF/closed-stdin
        # (CI, `bbb install-agent < /dev/null`, piped non-tty contexts).
        # Short-circuit with a clear instruction instead.
        [[ -t 0 ]] || die "no flags provided and stdin is not a tty; specify --rule/--skill/--claude/--agents"
        echo "Project: $PWD"
        echo "Status:"
        _agent_status_line ".claude/rules/bb-bash-rule.md"
        _agent_status_line ".claude/skills/bb-bash/SKILL.md"
        _agent_status_line_marked "CLAUDE.md" '## Bitbucket via bb-bash'
        _agent_status_line_marked "AGENTS.md" '## Bitbucket via bb-bash'
        echo ""
        echo "Install: [r=rule, s=skill, c=CLAUDE.md, a=AGENTS.md, q=quit]"
        local choice
        read -r -p "Combine letters (e.g. 'rs', 'ca', 'rsca') or q to quit: " choice
        if [[ "$choice" == "q" || -z "$choice" ]]; then
            echo "cancelled"
            return 0
        fi
        # Whitelist-validate before per-letter matching. Without this, any string
        # containing 'r' (e.g. "hello world") would silently turn on want_rule.
        [[ "$choice" =~ ^[rsca]+$ ]] || die "invalid letters in '$choice' (allowed: r/s/c/a, or q to quit)"
        [[ "$choice" == *r* ]] && want_rule=true
        [[ "$choice" == *s* ]] && want_skill=true
        [[ "$choice" == *c* ]] && want_claude=true
        [[ "$choice" == *a* ]] && want_agents=true
    fi

    local rule_dest skill_dest claudemd_dest agentsmd_dest base_label
    if [[ "$INSTALL_AGENT_GLOBAL" == "true" ]]; then
        rule_dest="$HOME/.claude/rules/bb-bash-rule.md"
        skill_dest="$HOME/.claude/skills/bb-bash/SKILL.md"
        claudemd_dest="$HOME/.claude/CLAUDE.md"
        # agentsmd_dest unset — validated to be blocked above
        base_label="$HOME/.claude (global)"
    else
        rule_dest=".claude/rules/bb-bash-rule.md"
        skill_dest=".claude/skills/bb-bash/SKILL.md"
        claudemd_dest="CLAUDE.md"
        agentsmd_dest="AGENTS.md"
        base_label="$PWD"
    fi

    local mode_label
    if [[ "$INSTALL_AGENT_DRY_RUN" == "true" ]]; then
        mode_label="dry-run"
    else
        mode_label="live"
    fi
    echo "Installing into $base_label ($mode_label, ref=${BB_BASH_REF:-main})"

    $want_rule     && _install_agent_fetch "bb-bash-rule.md"        "$rule_dest"
    $want_skill    && _install_agent_fetch "bb-bash-skill/SKILL.md" "$skill_dest"
    $want_claude   && _install_agent_md_section "$claudemd_dest"
    $want_agents   && _install_agent_md_section "$agentsmd_dest"

    echo "Done."
}

# --- Help ---
